{
    "abbrev": "",
    "description": [
        "Claude direct-edit library: Proofread (scientific+writing+LaTeX, with %N markers), scientific fix/report, writing, LaTeX, references, structure, rewrite, translate."
    ],
    "formatVersion": 1,
    "menu": "",
    "name": "Claude-PromptLibrary.txsMacro",
    "shortcut": "Shift+F2",
    "tag": [
        "%SCRIPT",
        "",
        "// #########################################################################",
        "// Configure Python and the Claude helper script",
        "var python_path = \"/path/to/file/python3\";",
        "var script_path = \"/Users/username/path/to/claude_python_script.py\";",
        "// #########################################################################",
        "",
        "// mode \"replace\": Claude's corrected text replaces the selection (mark:true also adds %N lines above/below)",
        "// mode \"review\" : the text stays, Claude's report is added below it as % comments",
        "",
        "var promptOptions = [",
        "    {",
        "        name: \"Proofread — علمی + نگارشی + لاتک (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: true,",
        "        instruction: [",
        "            \"Proofread and fix the following text directly, all at once: (1) scientific imprecision or errors, only where you are sure;\",",
        "            \"(2) Persian writing: spelling, grammar, punctuation (، ؛ ؟ « »), half-spaces, awkward sentences rewritten in precise, fluent academic Persian;\",",
        "            \"(3) LaTeX errors (formulas, \\\\ref/\\\\label/\\\\cite, environments, spacing, \\\\lr{} for English inside Persian).\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"اصلاح علمی (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Fix scientific problems directly, only where you are sure: wrong equations, signs, factors or units; incorrect or imprecise\",",
        "            \"definitions and terminology; overstated or unsupported claims (soften them); inconsistent notation. Do not touch style otherwise.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"بررسی علمی (گزارش)\",",
        "        mode: \"review\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Review the following excerpt of a physics PhD thesis for SCIENTIFIC correctness only: physical/mathematical errors (equations, signs,\",",
        "            \"factors, units, dimensional consistency), incorrect or imprecise definitions and terminology, unjustified or overstated claims,\",",
        "            \"logical gaps, inconsistent notation, missing assumptions, statements needing a citation. Ignore grammar, style and LaTeX.\",",
        "            \"Rate each finding [مهم] or [پیشنهاد]. You only see an excerpt, so say so if something may be defined elsewhere.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"اصلاح نگارشی (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Fix Persian writing directly: spelling, grammar, punctuation (، ؛ ؟ « » and spacing), half-spaces (نیم‌فاصله), Arabic ي/ك to ی/ک,\",",
        "            \"formal academic register, consistent translation of terms, and rewrite unnatural or overlong sentences fluently and precisely.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"اصلاح ایرادات لاتک (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Fix LaTeX problems directly: unbalanced braces, \\\\begin/\\\\end mismatches, unescaped special characters, math-mode mistakes\",",
        "            \"(\\\\sin etc., \\\\text vs \\\\mathrm, \\\\left/\\\\right), eqnarray -> align, missing ~ before \\\\ref/\\\\cite, caption/label order,\",",
        "            \"and xepersian issues (English words/numbers inside Persian text wrapped in \\\\lr{...}, Persian text in math via \\\\text{...}).\",",
        "            \"Do not change wording.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"اصلاح رفرنس‌ها و ارجاعات (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Fix citation problems directly: consistent \\\\cite/\\\\citep/\\\\citet style, placement relative to punctuation and Persian text direction,\",",
        "            \"well-formed keys; in BibTeX/BibLaTeX entries: consistent field formatting, name order, abbreviations, capitalization, duplicate fields.\",",
        "            \"Never invent references, DOIs or bibliographic details; keep any entry you cannot fix confidently unchanged.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"اصلاح ساختار و انسجام (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Improve structure and coherence directly: correct sectioning levels (\\\\chapter/\\\\section/\\\\subsection), reorder paragraphs only when the\",",
        "            \"logic clearly requires it, add or fix connecting phrases, merge duplicated sentences. Keep all content; add nothing new.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"بازنویسی آکادمیک فارسی (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Rewrite in polished, formal academic Persian suitable for a physics PhD thesis: better flow, clarity and concision, exact meaning kept.\"",
        "        ].join(\"\\n\")",
        "    },",
        "    {",
        "        name: \"ترجمه به فارسی (مستقیم)\",",
        "        mode: \"replace\",",
        "        mark: false,",
        "        instruction: [",
        "            \"Translate into formal Persian suitable for a physics PhD thesis. Keep standard English terms that have no established Persian\",",
        "            \"equivalent wrapped in \\\\lr{...}.\"",
        "        ].join(\"\\n\")",
        "    }",
        "];",
        "",
        "var selectedText = cursor.selectedText();",
        "",
        "if (selectedText === \"\") {",
        "    alert(\"Please select some text first.\\n\\nلطفاً ابتدا متن را انتخاب کنید.\");",
        "} else {",
        "    var optionNames = promptOptions.map(function(o) { return o.name; });",
        "    var dlg = new UniversalInputDialog();",
        "    dlg.setWindowTitle(\"Claude Prompt Library\");",
        "    dlg.add(optionNames, \"Choose an action:\", \"selectbox\");",
        "    if (dlg.exec()) {",
        "        var chosen = dlg.get(\"selectbox\").toString();",
        "        var option = null;",
        "        promptOptions.forEach(function(o) { if (o.name === chosen) option = o; });",
        "        if (option !== null) runOption(option);",
        "    }",
        "}",
        "",
        "function runOption(option) {",
        "    var job = {",
        "        mode: option.mode,",
        "        mark: option.mark,",
        "        label: option.name,",
        "        instruction: option.instruction,",
        "        text: selectedText,",
        "        source_file: \"\"",
        "    };",
        "    var inputFile = app.getAbsoluteFilePath(\".txs-claude-prompt-\" + Date.now(), \"tmp\");",
        "    writeFile(inputFile, JSON.stringify(job));",
        "    var command = quoteArg(python_path) + \" \" + quoteArg(script_path) + \" --input-file \" + quoteArg(inputFile);",
        "    execute(command);",
        "}",
        "",
        "function execute(command) {",
        "    // IMPORTANT: do NOT redirect stdout to /dev/null; the response comes through stdout.",
        "    cmd = system(command);",
        "    var menu = app.getManagedMenu(\"main/macros\");",
        "    var act = app.newManagedAction(menu, \"PromptLib\", \"Stop Claude PromptLib\");",
        "    act.triggered.connect(function(){ cmd.terminate(); });",
        "    cmd.standardOutputRead.connect(function(output) {",
        "        editor.write(output);",
        "    });",
        "    cmd.standardErrorRead.connect(function(output) {",
        "        editor.write(output);",
        "    });",
        "}",
        "",
        "function quoteArg(arg) {",
        "    return \"\\\"\" + arg.replace(/([\\\"\\\\$`])/g, \"\\\\$1\") + \"\\\"\";",
        "}",
        ""
    ],
    "trigger": ""
}